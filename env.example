# Secreto para firmar las sesiones. Genera uno con:  openssl rand -hex 32
JWT_SECRET=

# Administrador inicial (solo se usa si la base está vacía, en el primer arranque).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Horas que dura una sesión.
SESSION_HOURS=12

# Pon "true" si la app se sirve por HTTPS (detrás de un proxy inverso con TLS).
COOKIE_SECURE=false

# Pon "true" si hay un proxy inverso delante (nginx, Traefik, IIS) para registrar la IP real.
TRUST_PROXY=false

# ---------- Active Directory / LDAP (opcional) ----------
# Si LDAP_URL queda vacío, solo se usan cuentas locales.
# Usa ldaps:// (puerto 636) o ldap:// con LDAP_STARTTLS=true: si no, las contraseñas viajan sin cifrar.
LDAP_URL=
# LDAP_URL=ldaps://dc01.empresa.local:636

# Cuenta de servicio de solo lectura, usada para buscar a las personas.
LDAP_BIND_DN=
# LDAP_BIND_DN=CN=svc-kanban,OU=Servicios,DC=empresa,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# LDAP_BASE_DN=DC=empresa,DC=local

# Solo los miembros de este grupo pueden entrar (vacío = cualquier persona del directorio).
LDAP_ALLOWED_GROUP_DN=
# LDAP_ALLOWED_GROUP_DN=CN=Kanban-Usuarios,OU=Grupos,DC=empresa,DC=local

# Los miembros de este grupo son administradores del tablero; se sincroniza en cada ingreso.
# Vacío = el rol se administra a mano desde la pantalla Usuarios.
LDAP_ADMIN_GROUP_DN=

# Crear la cuenta automáticamente en el primer ingreso. Con "false", un admin debe crearla antes.
LDAP_AUTO_CREATE=true

# Opcionales
# LDAP_STARTTLS=false
# LDAP_CA_FILE=/certs/ca-empresa.pem        (monta el archivo en el contenedor)
# LDAP_TLS_REJECT_UNAUTHORIZED=true         (no lo pongas en false en producción)
# LDAP_NESTED_GROUPS=true                   (grupos anidados de AD; false para OpenLDAP)
# LDAP_DISPLAY_NAME_ATTR=displayName
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={{username}}))
